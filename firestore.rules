rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Volunteer applications — anyone can submit; admin reads via dashboard
    match /volunteers/{id} {
      allow create: if true;
      allow read, update: if true;
      allow delete: if false;
    }

    // Contact messages — anyone can submit; admin reads via dashboard
    match /contact/{id} {
      allow create: if true;
      allow read, update: if true;
      allow delete: if false;
    }

    // Check-ins — public read so every volunteer sees the community feed;
    // anyone authenticated via the app can create; no edits or deletes
    match /checkins/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
